<?xml version="1.0" encoding="UTF-8"?>
<!--
  로그 설정.
  로컬은 콘솔만, 운영은 콘솔 + 파일(일별 로테이션, 30일 보관)로 남긴다.
  파일 위치는 application-prod.properties 의 logging.file.path 를 따른다.
-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

    <springProperty name="LOG_PATH" source="logging.file.path" defaultValue="./logs"/>

    <springProfile name="!prod">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <springProfile name="prod">
        <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>${LOG_PATH}/idis.log</file>
            <encoder>
                <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
                <charset>UTF-8</charset>
            </encoder>
            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <fileNamePattern>${LOG_PATH}/idis.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
                <!-- 하루 단위로 넘기고 30일치만 남긴다 -->
                <maxHistory>30</maxHistory>
                <!-- 하루에 로그가 몰려도 파일 하나가 너무 커지지 않게 쪼갠다 -->
                <maxFileSize>50MB</maxFileSize>
                <!-- 디스크가 작으니 전체 상한도 둔다 (2GB 플랜) -->
                <totalSizeCap>1GB</totalSizeCap>
            </rollingPolicy>
        </appender>

        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE"/>
        </root>
    </springProfile>
</configuration>
